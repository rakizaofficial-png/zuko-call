{
  "expo": {
    "name": "Zuko",
    "slug": "zuko",
    "version": "1.0.17",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "backgroundColor": "#0b0d12",
      "barStyle": "light-content",
      "translucent": false,
      "hidden": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zuko.user",
      "infoPlist": {
        "NSCameraUsageDescription": "Zuko needs camera for video calls.",
        "NSMicrophoneUsageDescription": "Zuko needs microphone for calls.",
        "NSPhotoLibraryUsageDescription": "Zuko needs photos for your profile."
      }
    },
    "android": {
      "package": "com.zuko.user",
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0d12"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "MODIFY_AUDIO_SETTINGS",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "extra": {
      "lumaWebUrl": "https://luma-user.onrender.com",
      "eas": {
        "projectId": "ca37eee3-f703-46a0-8218-dfb112bf6851"
      }
    },
    "owner": "salman112211",
    "plugins": [
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b0d12"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "kotlinVersion": "2.2.0"
          }
        }
      ],
      "./plugins/withSecureScreen"
    ]
  }
}
